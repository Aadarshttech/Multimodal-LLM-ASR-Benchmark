def normalize_for_eval(text):
    if text is None:
        return ""

    text = unicodedata.normalize("NFC", str(text)).lower()

    chars = []
    for ch in text:
        cat = unicodedata.category(ch)
        if cat.startswith("P") or cat == "Nd":
            chars.append(" ")
        else:
            chars.append(ch)

    return re.sub(r"\s+", " ", "".join(chars)).strip()

