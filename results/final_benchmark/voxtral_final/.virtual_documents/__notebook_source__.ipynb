WRAPPER_PREFIXES = [
    r"^\s*\*{0,2}\s*transcription\s*\*{0,2}\s*:\s*",
    r"^\s*\*{0,2}\s*transcript\s*\*{0,2}\s*:\s*",
    r"^\s*\*{0,2}\s*output\s*\*{0,2}\s*:\s*",
    r"^\s*```(?:text)?\s*",
]

def clean_output(raw_output):
    text = "" if raw_output is None else str(raw_output).strip()
    for pattern in WRAPPER_PREFIXES:
        text = re.sub(pattern, "", text, flags=re.IGNORECASE)
    text = re.sub(r"\s*```\s*$", "", text)
    return text.strip(" \t\r\n`*")

def build_conversation(audio_path, prompt_text):
    return [{
        "role": "user",
        "content": [
            {"type": "audio", "path": audio_path},
            {"type": "text", "text": prompt_text},
        ],
    }]

def transcribe_one(audio_path, prompt_text):
    conversation = build_conversation(audio_path, prompt_text)

    inputs = processor.apply_chat_template(conversation)
    inputs = inputs.to(INPUT_DEVICE, dtype=model.dtype)

    if torch.cuda.is_available():
        torch.cuda.synchronize()

    t0 = time.perf_counter()

    with torch.inference_mode():
        output_ids = model.generate(
            **inputs,
            max_new_tokens=MAX_NEW_TOKENS,
            do_sample=DO_SAMPLE,
        )

    if torch.cuda.is_available():
        torch.cuda.synchronize()

    elapsed = time.perf_counter() - t0

    new_tokens = output_ids[
        :,
        inputs["input_ids"].shape[1]:,
    ]
    decoded = processor.batch_decode(
        new_tokens,
        skip_special_tokens=True,
    )[0]

    return decoded, int(new_tokens.shape[1]), float(elapsed)

PREDICTIONS_PATH = RUN_DIR / "voxtral_predictions.jsonl"

def completed_cases(output_path):
    completed = set()

    if not Path(output_path).exists():
        return completed

    with jsonlines.open(output_path) as reader:
        for obj in reader:
            if (
                obj.get("manifest_hash") == MANIFEST_HASH
                and obj.get("promptset_hash") == PROMPTSET_HASH
                and str(obj.get("resolved_model_revision", ""))
                    == str(resolved_revision)
            ):
                completed.add(
                    (obj["sample_id"], obj["prompt_id"])
                )

    return completed

def run_inference(manifest_df, output_path):
    output_path = Path(output_path)
    completed = completed_cases(output_path)

    total = len(manifest_df) * len(PROMPT_IDS)
    pbar = tqdm(
        total=total,
        initial=len(completed),
        desc="Voxtral OSLR54",
    )

    for _, row in manifest_df.iterrows():
        for pid in PROMPT_IDS:
            key = (row["sample_id"], pid)
            if key in completed:
                continue

            spec = PROMPT_SPECS[pid]

            record = {
                "model_id": MODEL_ID,
                "requested_model_revision": MODEL_REV,
                "resolved_model_revision": resolved_revision,
                "manifest_hash": MANIFEST_HASH,
                "promptset_hash": PROMPTSET_HASH,
                "sample_id": row["sample_id"],
                "utterance_id": row["utterance_id"],
                "source": row["source"],
                "prompt_id": pid,
                "prompt_level": spec["level"],
                "prompt_family": spec["family"],
                "prompt_hash": spec["prompt_hash"],
                "prompt_text": spec["text"],
                "audio_path": row["audio_path"],
                "resolved_audio_path": row["resolved_audio_path"],
                "reference_original": row["reference_original"],
                "reference_dataset_normalized": (
                    row["reference_dataset_normalized"]
                ),
                "reference_normalized": row["reference_normalized"],
                "duration_sec": float(row["duration_sec"]),
                "status": "success",
                "raw_output": "",
                "cleaned_prediction": "",
                "prediction_normalized": "",
                "generated_tokens": 0,
                "inference_seconds": 0.0,
                "real_time_factor": np.nan,
                "error_type": "",
                "error_message": "",
                "timestamp_utc": datetime.now(timezone.utc).isoformat(),
            }

            try:
                raw, n_new, seconds = transcribe_one(
                    row["resolved_audio_path"],
                    spec["text"],
                )

                record["inference_seconds"] = round(seconds, 4)
                record["real_time_factor"] = round(
                    seconds / float(row["duration_sec"]),
                    4,
                )
                record["generated_tokens"] = n_new
                record["raw_output"] = raw
                record["cleaned_prediction"] = clean_output(raw)
                record["prediction_normalized"] = normalize_for_eval(
                    record["cleaned_prediction"]
                )

                if not record["cleaned_prediction"]:
                    record["status"] = "empty_output"

            except torch.cuda.OutOfMemoryError as e:
                record["status"] = "out_of_memory"
                record["error_type"] = type(e).__name__
                record["error_message"] = str(e)
                gc.collect()
                torch.cuda.empty_cache()

            except Exception as e:
                record["status"] = "inference_error"
                record["error_type"] = type(e).__name__
                record["error_message"] = str(e)

            with jsonlines.open(output_path, mode="a") as writer:
                writer.write(record)

            completed.add(key)
            pbar.update(1)

    pbar.close()
    print("Saved:", output_path)
    return output_path





