def prompt_hash(text, shot_payload=None):
    payload = {"text": text, "shots": shot_payload or []}
    canonical = json.dumps(
        payload,
        sort_keys=True,
        ensure_ascii=False,
    )
    return hashlib.sha256(
        canonical.encode("utf-8")
    ).hexdigest()

PROMPT_SPECS = {
    pid: {
