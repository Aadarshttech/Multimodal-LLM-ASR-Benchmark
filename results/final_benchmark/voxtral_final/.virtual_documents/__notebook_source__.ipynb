        "family": PROMPT_META[pid][1],
        "text": PROMPT_TEXTS[pid],
        "prompt_hash": prompt_hash(PROMPT_TEXTS[pid]),
    }
    for pid in PROMPT_IDS
}

PROMPTSET_HASH = hashlib.sha256(
